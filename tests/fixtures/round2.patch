+def cancel_order(path, orders, reference, now):
+    order = next((row for row in orders if row["reference"] == reference), None)
+    if order is None or order.get("cancelled"):
+        print("Order not found. Check the reference in the orders list.")
+        return 1
+
+    day_before = date.fromisoformat(order["pickup"]) - timedelta(days=1)
+    cutoff = datetime.combine(day_before, time(hour=18))
+    if now >= cutoff:
+        print("The order can be cancelled until 18:00 the day before pickup.")
+        return 1
+
+    order["cancelled"] = True
+    save_orders(path, orders)
+    print(f"Order {reference} cancelled.")
+    return 0
+
+
